<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="car">

  <!-- ============== PARAMETRI ============== -->
  <!-- Percorsi mesh (modifica questi) -->
  <xacro:property name="pkg_share" value="$(find msauber)"/>
  <xacro:property name="body_mesh"  value="${pkg_share}/description/meshes/msauber_body.stl"/>
  <xacro:property name="wheel_mesh" value="${pkg_share}/description/meshes/msauber_wheeel.stl"/>

  <!-- Scale mesh (se serve) -->
  <xacro:property name="body_scale"  value="1 1 1"/>
  <xacro:property name="wheel_scale" value="1 1 1"/>

  <!-- Geometria base (modifica questi) -->
  <!-- wheelbase = distanza tra asse anteriore e posteriore -->
  <xacro:property name="wheelbase" value="6.2"/>
  <!-- track = distanza tra ruota sinistra e destra -->
  <xacro:property name="track" value="3.5"/>
  <!-- quota centro ruota (rispetto al base_link) -->
  <xacro:property name="wheel_z" value="-0.7"/>

  <!-- opzionale: massa (placeholder) -->
  <xacro:property name="body_mass"  value="500"/>
  <xacro:property name="wheel_mass" value="25"/>

  <!-- Materiali base -->
  <material name="body_gray">
    <color rgba="0.55 0.55 0.55 1"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.02 0.02 0.02 1"/>
  </material>

  <!-- ============== LINK PRINCIPALE ============== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${body_mesh}" scale="${body_scale}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>

    <!-- collision: puoi usare la mesh o una shape semplice -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${body_mesh}" scale="${body_scale}"/>
      </geometry>
    </collision>

    <!-- inertial placeholder (meglio sostituirlo con valori reali) -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.10" iyz="0.0" izz="0.10"/>
    </inertial>
  </link>

  <!-- ============== MACRO RUOTA (link + visual/collision/inertial) ============== -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${wheel_mesh}" scale="${wheel_scale}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${wheel_mesh}" scale="${wheel_scale}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ============== RUOTE POSTERIORI (solo spin) ============== -->
  <xacro:wheel_link name="rear_right_wheel"/>
  <joint name="rear_right_wheel_spin" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <!-- centro ruota: x=-wheelbase/2, y=+track/2 -->
    <origin xyz="${-track/2} ${ wheelbase/2} ${wheel_z}" rpy="0 0 3.14"/>
    <!-- asse spin: cambia se il tuo modello ruota su un altro asse -->
    <axis xyz="1 0 0"/>
  </joint>

  <xacro:wheel_link name="rear_left_wheel"/>
  <joint name="rear_left_wheel_spin" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="${ track/2} ${ wheelbase/2} ${wheel_z}" rpy="0 0 3.14"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- ============== RUOTE ANTERIORI (sterzo + spin) ============== -->
  <!-- Link “intermedio” per lo sterzo: aggiungo un'inerzia minima così Gazebo non scarta il link -->
  <link name="front_right_steer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="front_right_steer" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer_link"/>
    <!-- centro ruota: x=+wheelbase/2, y=+track/2 -->
    <origin xyz="${-track/2} ${-wheelbase/2} ${wheel_z}" rpy="0 0 3.14"/>
    <!-- sterzo attorno a Z (come hai chiesto) -->
    <axis xyz="0 0 1"/>
    <!-- limiti sterzo (modifica a piacere) -->
    <limit lower="-0.7" upper="0.7" effort="5" velocity="3"/>
  </joint>

  <xacro:wheel_link name="front_right_wheel"/>
  <joint name="front_right_wheel_spin" type="continuous">
    <parent link="front_right_steer_link"/>
    <child link="front_right_wheel"/>
    <!-- qui l’origine è 0 perché il pivot è già nel centro ruota -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <link name="front_left_steer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="front_left_steer" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer_link"/>
    <origin xyz="${ track/2} ${-wheelbase/2} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7" upper="0.7" effort="5" velocity="3"/>
  </joint>

  <xacro:wheel_link name="front_left_wheel"/>
  <joint name="front_left_wheel_spin" type="continuous">
    <parent link="front_left_steer_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

</robot>
